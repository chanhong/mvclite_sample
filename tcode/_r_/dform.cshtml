<script type="text/javascript">
  $().ready(function () {
    var template = jQuery.validator.format($("#template").val());
    function addRow() {
      $(template(i--)).appendTo("#jvMailto tbody");         // dynamic append to this table id jvMailto WORKING!!!
    }
    var i = 999;
    // start with one row
    addRow();
    // add more rows on click
    $("#add").click(addRow);
  });
</script>
<style type="text/css">
  form.cmxform {
