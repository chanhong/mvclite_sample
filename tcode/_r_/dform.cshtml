<script type="text/javascript">
  $(function () {
    $("#full_email-{0}").autocomplete({
      source: "/ejvnetdev/?t=odata&a=_ldapuw&c=emailuw",
      minLength: 2,
      select: function (event, ui) {
        $("#person-{0}").val(ui.item.cn);
        $("#box_num-{0}").val(ui.item.mailstop);
      }
    });
    $("#person-{0}").autocomplete({
      source: "/ejvnetdev/?t=odata&a=_ldapuw&c=name",
      minLength: 2,
      select: function (event, ui) {
        $("#full_email-{0}").val(ui.item.mail);
        $("#box_num-{0}").val(ui.item.mailstop);
      }
    });
  });
</script>
